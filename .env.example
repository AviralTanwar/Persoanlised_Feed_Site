# OpenWeatherMap — https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_key_here

# NewsAPI — https://newsapi.org (free tier)
NEWS_API_KEY=your_key_here

# Motivational quotes API — replace with any quotes API you prefer
QUOTES_API_URL=https://motivational-spark-api.vercel.app/api/quotes/random

# Microsoft Graph (OneNote) — https://portal.azure.com
MS_CLIENT_ID=your_azure_client_id
MS_CLIENT_SECRET=your_azure_client_secret
MS_TENANT_ID=common
