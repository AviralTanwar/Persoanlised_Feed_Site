# Copy the values you need into a real env file. These are read server-side only.
#
# LOCAL DEV: put these in server/.env  (the local workflow runs `node index.js`
#   from the server/ folder, so dotenv loads server/.env).
# VERCEL:    add the SAME variables in the Vercel dashboard under
#   Settings → Environment Variables (this .env file is gitignored, so it is
#   never deployed).
#
# Nothing here may carry a VITE_ prefix — Vite inlines VITE_* into the browser
# bundle, and the service-role key must never reach the client.

# ── Supabase (Project Settings → API) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-side ONLY, never expose to the browser

# ── OpenWeatherMap (https://openweathermap.org/api, free tier) ─────────────
OPENWEATHER_API_KEY=

# Note: the news feeds, the quote sources, and the weather API base URL all
# live in the database now (tbl_news_feeds / tbl_quotes / tbl_weathers), so
# there are no NEWS_API_KEY, QUOTES_API_URL, or MS_* variables anymore.
